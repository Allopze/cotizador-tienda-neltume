{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "MCP_TOOL_TIMEOUT": "1800000"
  },
  "permissions": {
    "allow": [
      "mcp__codex__run",
      "mcp__codex__continue",
      "mcp__codex__review",
      "mcp__codex__start",
      "mcp__codex__status",
      "mcp__codex__result",
      "mcp__codex__cancel",
      "mcp__codex__reset_limit",
      "mcp__commandcode__run",
      "mcp__commandcode__continue",
      "mcp__commandcode__start",
      "mcp__commandcode__status",
      "mcp__commandcode__result",
      "mcp__commandcode__cancel",
      "mcp__commandcode__reset_limit",
      "Bash(scripts/wt.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git worktree list:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git reset:*)",
      "Bash(scripts/wt.sh rm:*)",
      "Bash(scripts/wt.sh integrate:*)",
      "Bash(scripts/wt.sh gc --apply:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)"
    ]
  }
}
