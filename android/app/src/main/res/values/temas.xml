<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash: el logo claro sobre el bosque, igual que el ícono. -->
    <style name="Tema.Neltume.Inicio" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bosque</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Tema.Neltume</item>
    </style>

    <style name="Tema.Neltume" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/papel</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
