<?xml version="1.0" encoding="utf-8"?>
<!-- La sesión y las preferencias no se respaldan ni se copian a otro teléfono: la cookie está cifrada con una llave
     del Keystore de este equipo. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
