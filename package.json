{
  "name": "neltume-cotizador",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "deploy": "node scripts/deploy.mjs --ssh chome --dir /srv/cotizador-neltume --port 3010",
    "deploy:zip": "node scripts/deploy.mjs",
    "verificar": "node scripts/deploy.mjs --solo-verificar",
    "start": "next start --hostname 127.0.0.1",
    "importar": "tsx scripts/importar.ts",
    "migrar:sqlite": "tsx scripts/migrar-sqlite.ts",
    "auth:migrar": "tsx scripts/migrar-auth.ts",
    "usuarios": "tsx scripts/usuarios.ts",
    "limpiar-borradores": "tsx scripts/limpiar-borradores.ts",
    "respaldar": "tsx scripts/respaldar.ts",
    "restaurar": "tsx scripts/restaurar.ts",
    "primer-arranque": "tsx scripts/primer-arranque.ts",
    "feriados": "tsx scripts/feriados.ts",
    "evaluar:ia": "tsx --env-file-if-exists=.env.local scripts/evaluar-ia.ts",
    "evaluar:regresion": "tsx --env-file-if-exists=.env.local scripts/evaluar-ia.ts --min 0.95 --min-perfectos 0.95 --repeticiones 3",
    "paridad:excel": "tsx scripts/paridad-excel.ts",
    "paridad:excel-ia": "tsx --env-file-if-exists=.env.local scripts/paridad-excel-ia.ts",
    "test": "vitest run && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "tsx scripts/preparar-e2e.ts && playwright test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src scripts tests *.ts *.json *.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "better-auth": "^1.7.6",
    "better-sqlite3": "^13.0.3",
    "fflate": "^0.8.2",
    "next": "^16.0.0",
    "playwright": "^1.58.0",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "saxes": "^6.0.0",
    "tsx": "^4.20.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "pdfjs-dist": "^6.3.289",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.2"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  }
}
