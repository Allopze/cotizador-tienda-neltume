CMD_API_KEY=your-api-key
CMD_MODEL=claude-sonnet-5
# Plazo máximo por solicitud (1.000–120.000 ms)
CMD_TIMEOUT_MS=60000
# CHROMIUM_PATH=/path/to/chromium
# Hostnames extra permitidos (p. ej. el de Cloudflare Access), separados por coma
# NELTUME_HOSTS=cotizador.example.cl
# Ruta opcional del archivo de categorías y alias del catálogo
# NELTUME_CATALOGO_CONFIG=config/catalogo.json
