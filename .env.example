CMD_API_KEY=your-api-key
CMD_MODEL=claude-sonnet-5
# Plazo máximo por solicitud (1.000–120.000 ms)
CMD_TIMEOUT_MS=60000
# Genera con `openssl rand -base64 32` y no compartas este secreto. Obligatorio en producción
# y siempre que NELTUME_HOSTS esté definido (instancia expuesta por túnel).
BETTER_AUTH_SECRET=
# En producción: origen HTTPS público; su hostname debe figurar en NELTUME_HOSTS.
BETTER_AUTH_URL=http://127.0.0.1:3000
# CHROMIUM_PATH=/path/to/chromium
# Hosts extra permitidos (p. ej. el de Cloudflare Access), separados por coma.
# Acepta `host`, `host:puerto` o `https://host[:puerto]`.
# NELTUME_HOSTS=cotizador.example.cl
# Ruta opcional del archivo de categorías y alias del catálogo
# NELTUME_CATALOGO_CONFIG=config/catalogo.json
# Los feriados se calculan solos y los decretados por única vez se sincronizan a diario desde
# api.boostr.cl. Descomenta para desactivar la sincronización (instalación sin internet).
# NELTUME_FERIADOS_SYNC=0
# Datos de la empresa impresos en los PDF (opcionales).
# NELTUME_EMPRESA_NOMBRE=Neltume.co
# NELTUME_EMPRESA_RUT=
# NELTUME_EMPRESA_DIRECCION=
# NELTUME_EMPRESA_TELEFONO=
# NELTUME_EMPRESA_WEB=
# NELTUME_EMPRESA_CORREO=Neltume.co@gmail.com
# Condiciones comerciales impresas en la cotización (opcionales; sin valor no se imprimen).
# NELTUME_CONDICIONES_PAGO=50 % al confirmar, saldo contra entrega
# NELTUME_PLAZO_ENTREGA=15 días hábiles desde la confirmación
# NELTUME_DATOS_BANCARIOS=Banco X · Cta. Cte. 000000 · RUT 76.059.066-5
